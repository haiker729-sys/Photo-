{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated photographer profile, Google Drive settings, and automatic upload preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the photographer." },
        "displayName": { "type": "string", "description": "Photographer display name." },
        "email": { "type": "string", "description": "Photographer email address." },
        "studioName": { "type": "string", "description": "Photography studio name." },
        "role": { "type": "string", "description": "Account role (photographer, admin, super_admin, owner)." },
        "profilePhotoUri": { "type": "string", "description": "Local URI or preset key of the photographer avatar." },
        "isVerified": { "type": "boolean", "description": "Whether the photographer studio is verified." },
        "membershipTier": { "type": "string", "description": "Membership badge tier." },
        "driveConnected": { "type": "boolean", "description": "Whether Google Drive backup is linked." },
        "driveAccountEmail": { "type": "string", "description": "Connected Google Drive account email." },
        "driveFolderName": { "type": "string", "description": "Target Google Drive folder name." },
        "driveSyncStatus": { "type": "string", "description": "Google Drive synchronization health status." },
        "localBackupFolderUri": { "type": "string", "description": "Selected phone folder URI for local backup." },
        "localBackupFolderName": { "type": "string", "description": "Readable display name for the selected phone backup folder." },
        "storageMode": { "type": "string", "description": "Selected backup mode: GoogleDrive, PhoneFolder, or Both." },
        "autoUploadEnabled": { "type": "boolean", "description": "Whether background automatic upload is enabled." },
        "wifiOnlyUpload": { "type": "boolean", "description": "Whether background uploads require Wi-Fi." },
        "batteryNotLowUpload": { "type": "boolean", "description": "Whether background uploads require sufficient battery." },
        "chargingOnlyUpload": { "type": "boolean", "description": "Whether background uploads require device charging." },
        "backgroundUploadAllowed": { "type": "boolean", "description": "Whether background WorkManager upload is permitted." },
        "uploadQualityMode": { "type": "string", "description": "Original Quality or High Efficiency." },
        "faceMatchAccuracyMode": { "type": "string", "description": "HighPrecision or Balanced." },
        "autoFaceIndexingEnabled": { "type": "boolean", "description": "Whether new event photos are automatically indexed for face matching." },
        "defaultGuestPrivacyMode": { "type": "string", "description": "FaceSearchOnly or FullEventGallery." },
        "biometricLockEnabled": { "type": "boolean", "description": "Whether studio app lock is enabled." },
        "subscriptionPlan": { "type": "string", "description": "Subscription plan code." },
        "accountStatus": { "type": "string", "description": "Active or Suspended account state." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": [
        "userId", "displayName", "email", "studioName", "role",
        "driveConnected", "driveFolderName", "autoUploadEnabled",
        "wifiOnlyUpload", "batteryNotLowUpload", "createdAt", "updatedAt"
      ]
    },
    "PhotoEvent": {
      "title": "PhotoEvent",
      "description": "Photography event workspace created by a photographer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owning photographer." },
        "name": { "type": "string", "description": "Event name." },
        "category": { "type": "string", "description": "Event category." },
        "eventDate": { "type": "string", "description": "Human-readable event date." },
        "location": { "type": "string", "description": "Event venue or city." },
        "coverType": { "type": "string", "description": "Preset artwork key." },
        "coverUri": { "type": "string", "description": "Custom cover photo URI if selected." },
        "status": { "type": "string", "description": "Active, Completed, Draft, or Suspended." },
        "qrCodeValue": { "type": "string", "description": "Unique guest portal link encoded in the event QR code." },
        "qrEnabled": { "type": "boolean", "description": "Whether the guest QR link is currently active." },
        "qrExpirationDate": { "type": "string", "description": "Expiration date for guest QR access." },
        "guestAccessMode": { "type": "string", "description": "FaceSearchOnly, FullEventGallery, or GuestChoice." },
        "guestAllowDownload": { "type": "boolean", "description": "Whether guests can download matched photos." },
        "pinProtected": { "type": "boolean", "description": "Whether guest gallery access requires a 4-6 digit PIN." },
        "guestAccessPin": { "type": "string", "description": "PIN code for guest gallery access when pinProtected is true." },
        "driveFolderId": { "type": "string", "description": "Google Drive folder ID created for this event." },
        "localFolderPath": { "type": "string", "description": "Local storage path for this event." },
        "storageMode": { "type": "string", "description": "GoogleDrive, PhoneFolder, or Both." },
        "totalPhotos": { "type": "integer", "description": "Total photos linked to this event." },
        "uploadedPhotos": { "type": "integer", "description": "Successfully backed up photos count." },
        "pendingPhotos": { "type": "integer", "description": "Queued or uploading photos count." },
        "failedPhotos": { "type": "integer", "description": "Failed upload photos count." },
        "driveSyncStatus": { "type": "string", "description": "Synced, Syncing, Attention, or NotConnected." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": [
        "userId", "name", "category", "eventDate", "location", "coverType",
        "coverUri", "status", "qrCodeValue", "qrEnabled", "qrExpirationDate",
        "guestAccessMode", "guestAllowDownload", "totalPhotos", "uploadedPhotos",
        "pendingPhotos", "failedPhotos", "driveSyncStatus", "createdAt", "updatedAt"
      ]
    },
    "PhotoUploadRecord": {
      "title": "PhotoUploadRecord",
      "description": "Metadata and upload queue status for an event photograph.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owning photographer." },
        "eventId": { "type": "string", "description": "ID of the parent PhotoEvent." },
        "eventName": { "type": "string", "description": "Cached name of the parent PhotoEvent." },
        "fileName": { "type": "string", "description": "Original file name." },
        "localUri": { "type": "string", "description": "Content URI or preset identifier." },
        "sourceType": { "type": "string", "description": "CameraCapture, GalleryImport, DSLRImport, or GoogleDriveImport." },
        "uploadMode": { "type": "string", "description": "Automatic or Manual." },
        "status": { "type": "string", "description": "Pending, Uploading, Paused, Uploaded, or Failed." },
        "progress": { "type": "integer", "description": "Upload progress percentage (0-100)." },
        "fileSizeBytes": { "type": "integer", "description": "File size in bytes." },
        "mimeType": { "type": "string", "description": "MIME type of the photo." },
        "faceIndexStatus": { "type": "string", "description": "Face indexing state." },
        "driveFileId": { "type": "string", "description": "Remote Google Drive file identifier." },
        "errorMessage": { "type": "string", "description": "Error reason when status is Failed." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": [
        "userId", "eventId", "eventName", "fileName", "localUri",
        "sourceType", "uploadMode", "status", "progress", "fileSizeBytes",
        "mimeType", "faceIndexStatus", "driveFileId", "errorMessage",
        "createdAt", "updatedAt"
      ]
    },
    "AdConfiguration": {
      "title": "AdConfiguration",
      "description": "Global and per-placement AdMob configuration managed from Jummo Admin Panel.",
      "type": "object",
      "properties": {
        "adsEnabled": { "type": "boolean" },
        "bannerEnabled": { "type": "boolean" },
        "interstitialEnabled": { "type": "boolean" },
        "rewardedEnabled": { "type": "boolean" },
        "appOpenEnabled": { "type": "boolean" },
        "homeBannerEnabled": { "type": "boolean" },
        "eventListBannerEnabled": { "type": "boolean" },
        "galleryBannerEnabled": { "type": "boolean" },
        "interstitialTransitionEnabled": { "type": "boolean" },
        "adFrequency": { "type": "integer" },
        "testMode": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "minimumAppVersion": { "type": "string" },
        "adMobAppId": { "type": "string" },
        "bannerAdUnitId": { "type": "string" },
        "interstitialAdUnitId": { "type": "string" },
        "rewardedAdUnitId": { "type": "string" },
        "appOpenAdUnitId": { "type": "string" },
        "consentRequired": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "RemoteAppSettings": {
      "title": "RemoteAppSettings",
      "description": "Admin-controlled remote configuration for Jummo Photos AI.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string" },
        "announcementBanner": { "type": "string" },
        "announcementEnabled": { "type": "boolean" },
        "minimumSupportedVersion": { "type": "string" },
        "forceUpdateRequired": { "type": "boolean" },
        "guestDownloadDefault": { "type": "boolean" },
        "defaultGuestAccessMode": { "type": "string" },
        "autoUploadDefault": { "type": "boolean" },
        "wifiOnlyDefault": { "type": "boolean" },
        "supportEmail": { "type": "string" },
        "supportPhone": { "type": "string" },
        "promotionalBannerEnabled": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdminAccountRecord": {
      "title": "AdminAccountRecord",
      "description": "Authorized administrator account and role definition in /admins/{adminId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "description": "Owner, SuperAdmin, Admin, SupportAdmin, or Analyst." },
        "isActive": { "type": "boolean" },
        "sessionRevoked": { "type": "boolean" },
        "grantedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Platform announcement, maintenance alert, or version notice sent from Jummo Admin Panel.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "targetAudience": { "type": "string" },
        "status": { "type": "string" },
        "scheduledAt": { "type": "string" },
        "sentBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable security audit record for administrative actions.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorRole": { "type": "string" },
        "actionType": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-photographer studio profile and settings."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/PhotoEvent" },
      "description": "Photography events owned by a specific photographer."
    },
    "/uploads/{uploadId}": {
      "schema": { "$ref": "#/entities/PhotoUploadRecord" },
      "description": "Photo upload queue items owned by a specific photographer."
    },
    "/appConfig/{configId}": {
      "schema": { "$ref": "#/entities/AdConfiguration" },
      "description": "Global app configuration documents: bannerSlider, adConfig, and remoteSettings."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminAccountRecord" },
      "description": "Server-verified administrator RBAC records."
    },
    "/admin_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AdminNotification" },
      "description": "Admin announcements and push notifications."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrative security audit trail."
    }
  }
}
