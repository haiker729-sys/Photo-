rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDocOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwner() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email == 'merajalam906090@gmail.com'
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isOwner()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'displayName', 'email', 'studioName', 'role',
          'driveConnected', 'driveFolderName', 'autoUploadEnabled',
          'wifiOnlyUpload', 'batteryNotLowUpload', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'displayName', 'email', 'studioName', 'role',
          'profilePhotoUri', 'isVerified', 'membershipTier',
          'driveConnected', 'driveAccountEmail', 'driveFolderName', 'driveSyncStatus',
          'localBackupFolderUri', 'localBackupFolderName', 'storageMode',
          'autoUploadEnabled', 'wifiOnlyUpload', 'batteryNotLowUpload',
          'chargingOnlyUpload', 'backgroundUploadAllowed', 'uploadQualityMode',
          'faceMatchAccuracyMode', 'autoFaceIndexingEnabled', 'defaultGuestPrivacyMode',
          'biometricLockEnabled', 'subscriptionPlan', 'accountStatus',
          'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() <= 160
        && data.studioName is string && data.studioName.size() >= 1 && data.studioName.size() <= 100
        && data.role in ['photographer', 'admin', 'super_admin', 'owner']
        && (!('profilePhotoUri' in data) || (data.profilePhotoUri is string && data.profilePhotoUri.size() <= 500))
        && (!('isVerified' in data) || data.isVerified is bool)
        && (!('membershipTier' in data) || (data.membershipTier is string && data.membershipTier.size() <= 60))
        && data.driveConnected is bool
        && (!('driveAccountEmail' in data) || (data.driveAccountEmail is string && data.driveAccountEmail.size() <= 160))
        && data.driveFolderName is string && data.driveFolderName.size() <= 120
        && (!('driveSyncStatus' in data) || data.driveSyncStatus in ['Synced', 'Syncing', 'NotConnected', 'Error'])
        && (!('localBackupFolderUri' in data) || (data.localBackupFolderUri is string && data.localBackupFolderUri.size() <= 500))
        && (!('localBackupFolderName' in data) || (data.localBackupFolderName is string && data.localBackupFolderName.size() <= 200))
        && (!('storageMode' in data) || data.storageMode in ['GoogleDrive', 'PhoneFolder', 'Both'])
        && data.autoUploadEnabled is bool
        && data.wifiOnlyUpload is bool
        && data.batteryNotLowUpload is bool
        && (!('chargingOnlyUpload' in data) || data.chargingOnlyUpload is bool)
        && (!('backgroundUploadAllowed' in data) || data.backgroundUploadAllowed is bool)
        && (!('uploadQualityMode' in data) || data.uploadQualityMode in ['OriginalQuality', 'HighEfficiency'])
        && (!('faceMatchAccuracyMode' in data) || data.faceMatchAccuracyMode in ['HighPrecision', 'Balanced'])
        && (!('autoFaceIndexingEnabled' in data) || data.autoFaceIndexingEnabled is bool)
        && (!('defaultGuestPrivacyMode' in data) || data.defaultGuestPrivacyMode in ['FaceSearchOnly', 'FullEventGallery', 'GuestChoice'])
        && (!('biometricLockEnabled' in data) || data.biometricLockEnabled is bool)
        && (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan.size() <= 60))
        && (!('accountStatus' in data) || data.accountStatus in ['Active', 'Suspended'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhotoEvent() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'name', 'category', 'eventDate', 'location', 'coverType',
          'coverUri', 'status', 'qrCodeValue', 'qrEnabled', 'qrExpirationDate',
          'guestAccessMode', 'guestAllowDownload', 'totalPhotos', 'uploadedPhotos',
          'pendingPhotos', 'failedPhotos', 'driveSyncStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'name', 'category', 'eventDate', 'location', 'coverType',
          'coverUri', 'status', 'qrCodeValue', 'qrEnabled', 'qrExpirationDate',
          'guestAccessMode', 'guestAllowDownload', 'pinProtected', 'guestAccessPin',
          'driveFolderId', 'localFolderPath', 'storageMode',
          'totalPhotos', 'uploadedPhotos', 'pendingPhotos', 'failedPhotos',
          'driveSyncStatus', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category in ['Wedding', 'Birthday', 'Festival', 'Corporate', 'School', 'Other']
        && data.eventDate is string && data.eventDate.size() >= 1 && data.eventDate.size() <= 40
        && data.location is string && data.location.size() <= 140
        && data.coverType is string && data.coverType.size() <= 40
        && data.coverUri is string && data.coverUri.size() <= 500
        && data.status in ['Active', 'Completed', 'Draft', 'Suspended']
        && data.qrCodeValue is string && data.qrCodeValue.size() <= 300
        && data.qrEnabled is bool
        && data.qrExpirationDate is string && data.qrExpirationDate.size() <= 40
        && data.guestAccessMode in ['FaceSearchOnly', 'FullEventGallery', 'GuestChoice']
        && data.guestAllowDownload is bool
        && (!('pinProtected' in data) || data.pinProtected is bool)
        && (!('guestAccessPin' in data) || (data.guestAccessPin is string && data.guestAccessPin.size() <= 12))
        && (!('driveFolderId' in data) || (data.driveFolderId is string && data.driveFolderId.size() <= 200))
        && (!('localFolderPath' in data) || (data.localFolderPath is string && data.localFolderPath.size() <= 400))
        && (!('storageMode' in data) || data.storageMode in ['GoogleDrive', 'PhoneFolder', 'Both'])
        && data.totalPhotos is int && data.totalPhotos >= 0
        && data.uploadedPhotos is int && data.uploadedPhotos >= 0
        && data.pendingPhotos is int && data.pendingPhotos >= 0
        && data.failedPhotos is int && data.failedPhotos >= 0
        && data.driveSyncStatus in ['Synced', 'Syncing', 'Attention', 'NotConnected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhotoUploadRecord() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'eventId', 'eventName', 'fileName', 'localUri',
          'sourceType', 'uploadMode', 'status', 'progress', 'fileSizeBytes',
          'mimeType', 'faceIndexStatus', 'driveFileId', 'errorMessage',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'eventId', 'eventName', 'fileName', 'localUri',
          'sourceType', 'uploadMode', 'status', 'progress', 'fileSizeBytes',
          'mimeType', 'faceIndexStatus', 'driveFileId', 'errorMessage',
          'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 120
        && data.eventName is string && data.eventName.size() >= 1 && data.eventName.size() <= 120
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && data.localUri is string && data.localUri.size() <= 500
        && data.sourceType in ['CameraCapture', 'GalleryImport', 'DSLRImport', 'GoogleDriveImport']
        && data.uploadMode in ['Automatic', 'Manual']
        && data.status in ['Pending', 'Uploading', 'Paused', 'Uploaded', 'Failed']
        && data.progress is int && data.progress >= 0 && data.progress <= 100
        && data.fileSizeBytes is int && data.fileSizeBytes >= 0
        && data.mimeType is string && data.mimeType.size() <= 80
        && data.faceIndexStatus in ['Indexed', 'AwaitingBackend', 'NotIndexed']
        && data.driveFileId is string && data.driveFileId.size() <= 200
        && data.errorMessage is string && data.errorMessage.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGuestFaceSession() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'eventId', 'eventName', 'guestLabel', 'consentAccepted',
          'selfieSource', 'matchedPhotoCount', 'matchStatus', 'privacyNote',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'eventId', 'eventName', 'guestLabel', 'consentAccepted',
          'selfieSource', 'matchedPhotoCount', 'matchStatus', 'privacyNote',
          'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 120
        && data.eventName is string && data.eventName.size() >= 1 && data.eventName.size() <= 120
        && data.guestLabel is string && data.guestLabel.size() >= 1 && data.guestLabel.size() <= 80
        && data.consentAccepted is bool
        && data.selfieSource in ['CameraSelfie', 'GalleryUpload']
        && data.matchedPhotoCount is int && data.matchedPhotoCount >= 0
        && data.matchStatus in ['Completed', 'ReportedMismatch', 'DataDeleted']
        && data.privacyNote is string && data.privacyNote.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHomeBanner() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'imageUri', 'storagePath', 'displayOrder',
          'isActive', 'slideDurationSeconds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'title', 'imageUri', 'storagePath', 'displayOrder',
          'isActive', 'status', 'visibility', 'targetPhotographerIds',
          'targetPlanIds', 'startAt', 'endAt', 'slideDurationSeconds',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && (!('title' in data) || (data.title is string && data.title.size() <= 120))
        && data.imageUri is string && data.imageUri.size() >= 1 && data.imageUri.size() <= 500
        && data.storagePath is string && data.storagePath.size() <= 300
        && data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 1000
        && data.isActive is bool
        && (!('status' in data) || data.status in ['ACTIVE', 'INACTIVE', 'SCHEDULED', 'EXPIRED', 'DRAFT'])
        && (!('visibility' in data) || data.visibility in ['ALL_PHOTOGRAPHERS', 'SELECTED_PHOTOGRAPHERS', 'SUBSCRIPTION_PLANS'])
        && (!('targetPhotographerIds' in data) || data.targetPhotographerIds is list)
        && (!('targetPlanIds' in data) || data.targetPlanIds is list)
        && (!('startAt' in data) || data.startAt == null || data.startAt is timestamp)
        && (!('endAt' in data) || data.endAt == null || data.endAt is timestamp)
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && data.slideDurationSeconds is int && data.slideDurationSeconds >= 2 && data.slideDurationSeconds <= 15
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBannerSliderConfig() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'autoSlide', 'slideDurationSeconds', 'infiniteLoop', 'manualSwipe',
          'smoothTransition', 'showIndicatorDots', 'bannerTextOverlay',
          'bannerCaptions', 'visibility', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'autoSlide', 'slideDurationSeconds', 'infiniteLoop', 'manualSwipe',
          'smoothTransition', 'showIndicatorDots', 'bannerTextOverlay',
          'bannerCaptions', 'visibility', 'updatedAt', 'updatedBy'
        ])
        && data.autoSlide is bool
        && data.slideDurationSeconds is int && data.slideDurationSeconds >= 2 && data.slideDurationSeconds <= 15
        && data.infiniteLoop is bool
        && data.manualSwipe is bool
        && data.smoothTransition is bool
        && data.showIndicatorDots is bool
        && data.bannerTextOverlay == false
        && data.bannerCaptions == false
        && data.visibility in ['ALL_PHOTOGRAPHERS', 'SELECTED_PHOTOGRAPHERS', 'SUBSCRIPTION_PLANS']
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidAdConfig() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'adsEnabled', 'bannerEnabled', 'interstitialEnabled', 'rewardedEnabled',
          'appOpenEnabled', 'homeBannerEnabled', 'eventListBannerEnabled',
          'galleryBannerEnabled', 'interstitialTransitionEnabled', 'adFrequency',
          'testMode', 'maintenanceMode', 'minimumAppVersion', 'updatedAt', 'updatedBy'
        ])
        && data.adsEnabled is bool
        && data.bannerEnabled is bool
        && data.interstitialEnabled is bool
        && data.rewardedEnabled is bool
        && data.appOpenEnabled is bool
        && data.homeBannerEnabled is bool
        && data.eventListBannerEnabled is bool
        && data.galleryBannerEnabled is bool
        && data.interstitialTransitionEnabled is bool
        && data.adFrequency is int && data.adFrequency >= 1 && data.adFrequency <= 50
        && data.testMode is bool
        && data.maintenanceMode is bool
        && data.minimumAppVersion is string && data.minimumAppVersion.size() <= 40
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidRemoteSettings() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'maintenanceMode', 'maintenanceMessage', 'announcementBanner',
          'announcementEnabled', 'minimumSupportedVersion', 'forceUpdateRequired',
          'guestDownloadDefault', 'defaultGuestAccessMode', 'autoUploadDefault',
          'wifiOnlyDefault', 'supportEmail', 'supportPhone', 'promotionalBannerEnabled',
          'updatedAt', 'updatedBy'
        ])
        && data.maintenanceMode is bool
        && data.maintenanceMessage is string && data.maintenanceMessage.size() <= 400
        && data.announcementBanner is string && data.announcementBanner.size() <= 400
        && data.announcementEnabled is bool
        && data.minimumSupportedVersion is string && data.minimumSupportedVersion.size() <= 40
        && data.forceUpdateRequired is bool
        && data.guestDownloadDefault is bool
        && data.defaultGuestAccessMode in ['FaceSearchOnly', 'FullEventGallery', 'GuestChoice']
        && data.autoUploadDefault is bool
        && data.wifiOnlyDefault is bool
        && data.supportEmail is string && data.supportEmail.size() <= 160
        && data.supportPhone is string && data.supportPhone.size() <= 60
        && data.promotionalBannerEnabled is bool
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidAdminAccountRecord(adminId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'email', 'displayName', 'role', 'isActive',
          'sessionRevoked', 'grantedBy', 'createdAt', 'updatedAt'
        ])
        && data.userId == adminId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['Owner', 'SuperAdmin', 'Admin', 'SupportAdmin', 'Analyst']
        && data.isActive is bool
        && data.sessionRevoked is bool
        && data.grantedBy is string && data.grantedBy.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminNotification() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'title', 'message', 'category', 'targetAudience',
          'status', 'scheduledAt', 'sentBy', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && data.category in ['Announcement', 'Maintenance', 'VersionNotice', 'ServiceStatus']
        && data.targetAudience in ['AllUsers', 'PhotographersOnly', 'GuestsOnly', 'ActiveEvents']
        && data.status in ['Sent', 'Scheduled', 'Draft', 'Archived']
        && data.scheduledAt is string && data.scheduledAt.size() <= 80
        && data.sentBy is string && data.sentBy.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'actorUid', 'actorEmail', 'actorRole', 'actionType',
          'targetType', 'targetId', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'actorUid', 'actorEmail', 'actorRole', 'actionType',
          'targetType', 'targetId', 'summary', 'createdAt'
        ])
        && data.actorUid == request.auth.uid
        && data.actorEmail is string && data.actorEmail.size() <= 160
        && data.actorRole is string && data.actorRole.size() <= 60
        && data.actionType is string && data.actionType.size() >= 1 && data.actionType.size() <= 80
        && data.targetType is string && data.targetType.size() <= 80
        && data.targetId is string && data.targetId.size() <= 160
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidWebsiteCustomization() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'eventId', 'eventName', 'brandingEnabled',
          'studioName', 'photographerName', 'logoUri', 'profileImageUri',
          'coverImageUri', 'bannerUrisCsv', 'autoSliderEnabled',
          'sliderIntervalSeconds', 'bannerHeightMode', 'bannerCropMode',
          'theme', 'primaryAccentHex', 'secondaryAccentHex', 'fontFamily',
          'layout', 'welcomeMessage', 'contactEmail', 'contactPhone',
          'studioLocation', 'instagramUrl', 'portfolioUrl',
          'faceSearchEnabled', 'galleryEnabled', 'downloadsEnabled',
          'shareEnabled', 'guestAccessMode', 'publicationStatus',
          'publishedVersion', 'publishedUrl', 'hasUnpublishedChanges',
          'adminAuditNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'eventId', 'eventName', 'brandingEnabled',
          'studioName', 'photographerName', 'logoUri', 'profileImageUri',
          'coverImageUri', 'bannerUrisCsv', 'autoSliderEnabled',
          'sliderIntervalSeconds', 'bannerHeightMode', 'bannerCropMode',
          'theme', 'primaryAccentHex', 'secondaryAccentHex', 'fontFamily',
          'layout', 'welcomeMessage', 'contactEmail', 'contactPhone',
          'studioLocation', 'instagramUrl', 'portfolioUrl',
          'faceSearchEnabled', 'galleryEnabled', 'downloadsEnabled',
          'shareEnabled', 'guestAccessMode', 'publicationStatus',
          'publishedVersion', 'publishedUrl', 'hasUnpublishedChanges',
          'adminAuditNote', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 120
        && data.eventName is string && data.eventName.size() <= 140
        && data.brandingEnabled is bool
        && data.studioName is string && data.studioName.size() <= 120
        && data.photographerName is string && data.photographerName.size() <= 100
        && data.logoUri is string && data.logoUri.size() <= 500
        && data.profileImageUri is string && data.profileImageUri.size() <= 500
        && data.coverImageUri is string && data.coverImageUri.size() <= 500
        && data.bannerUrisCsv is string && data.bannerUrisCsv.size() <= 3000
        && data.autoSliderEnabled is bool
        && data.sliderIntervalSeconds is int && data.sliderIntervalSeconds >= 2 && data.sliderIntervalSeconds <= 15
        && data.bannerHeightMode in ['Compact', 'Standard', 'Cinematic']
        && data.bannerCropMode in ['CenterCrop', 'FitCenter']
        && data.theme in ['RoyalPurple', 'LuxuryGold', 'MidnightBlack', 'MinimalWhite', 'WeddingRose']
        && data.primaryAccentHex is string && data.primaryAccentHex.size() <= 16
        && data.secondaryAccentHex is string && data.secondaryAccentHex.size() <= 16
        && data.fontFamily in ['PlayfairDisplay', 'PlusJakartaSans', 'CormorantGaramond', 'Montserrat']
        && data.layout in ['ClassicGrid', 'Masonry', 'ModernCards', 'FullWidthHero', 'Editorial']
        && data.welcomeMessage is string && data.welcomeMessage.size() <= 500
        && data.contactEmail is string && data.contactEmail.size() <= 160
        && data.contactPhone is string && data.contactPhone.size() <= 60
        && data.studioLocation is string && data.studioLocation.size() <= 160
        && data.instagramUrl is string && data.instagramUrl.size() <= 300
        && data.portfolioUrl is string && data.portfolioUrl.size() <= 300
        && data.faceSearchEnabled is bool
        && data.galleryEnabled is bool
        && data.downloadsEnabled is bool
        && data.shareEnabled is bool
        && data.guestAccessMode in ['FaceSearchOnly', 'FullEventGallery', 'GuestChoice']
        && data.publicationStatus in ['Draft', 'Published', 'Suspended']
        && data.publishedVersion is int && data.publishedVersion >= 0
        && data.publishedUrl is string && data.publishedUrl.size() <= 400
        && data.hasUnpublishedChanges is bool
        && data.adminAuditNote is string && data.adminAuditNote.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteVersionSnapshot() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId', 'eventId', 'customizationId', 'versionNumber',
          'studioName', 'photographerName', 'logoUri', 'coverImageUri',
          'bannerUrisCsv', 'theme', 'layout', 'welcomeMessage',
          'guestAccessMode', 'faceSearchEnabled', 'galleryEnabled',
          'downloadsEnabled', 'publishedUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'eventId', 'customizationId', 'versionNumber',
          'studioName', 'photographerName', 'logoUri', 'coverImageUri',
          'bannerUrisCsv', 'theme', 'layout', 'welcomeMessage',
          'guestAccessMode', 'faceSearchEnabled', 'galleryEnabled',
          'downloadsEnabled', 'publishedUrl', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 120
        && data.customizationId is string && data.customizationId.size() >= 1 && data.customizationId.size() <= 120
        && data.versionNumber is int && data.versionNumber >= 1
        && data.studioName is string && data.studioName.size() <= 120
        && data.photographerName is string && data.photographerName.size() <= 100
        && data.logoUri is string && data.logoUri.size() <= 500
        && data.coverImageUri is string && data.coverImageUri.size() <= 500
        && data.bannerUrisCsv is string && data.bannerUrisCsv.size() <= 3000
        && data.theme in ['RoyalPurple', 'LuxuryGold', 'MidnightBlack', 'MinimalWhite', 'WeddingRose']
        && data.layout in ['ClassicGrid', 'Masonry', 'ModernCards', 'FullWidthHero', 'Editorial']
        && data.welcomeMessage is string && data.welcomeMessage.size() <= 500
        && data.guestAccessMode in ['FaceSearchOnly', 'FullEventGallery', 'GuestChoice']
        && data.faceSearchEnabled is bool
        && data.galleryEnabled is bool
        && data.downloadsEnabled is bool
        && data.publishedUrl is string && data.publishedUrl.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if (isSignedIn() && request.auth.uid == adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner() && isValidAdminAccountRecord(adminId);
      allow delete: if isOwner();
    }

    match /users/{userId} {
      allow get: if isDocOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isDocOwner(userId)
        && isValidUserProfile(userId)
        && (request.resource.data.role == 'photographer' || isOwner());
      allow update: if (isDocOwner(userId)
        && isValidUserProfile(userId)
        && (request.resource.data.role == resource.data.role || isOwner())
        && request.resource.data.createdAt == resource.data.createdAt)
        || (isAdmin() && isValidUserProfile(userId));
      allow delete: if isDocOwner(userId) || isOwner();
    }

    match /events/{eventId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidPhotoEvent();
      allow update: if (isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidPhotoEvent()
        && request.resource.data.createdAt == resource.data.createdAt)
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /uploads/{uploadId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidPhotoUploadRecord();
      allow update: if (isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidPhotoUploadRecord()
        && request.resource.data.createdAt == resource.data.createdAt)
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /guest_face_sessions/{sessionId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidGuestFaceSession();
      allow update: if (isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidGuestFaceSession()
        && request.resource.data.createdAt == resource.data.createdAt)
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /home_banners/{bannerId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidHomeBanner();
      allow update: if (isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidHomeBanner()
        && request.resource.data.createdAt == resource.data.createdAt)
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /appConfig/{configId} {
      allow get, list: if isSignedIn() && configId in ['bannerSlider', 'adConfig', 'remoteSettings'];
      allow create, update: if isSignedIn() && (
        (configId == 'bannerSlider' && isValidBannerSliderConfig())
        || (configId == 'adConfig' && isAdmin() && isValidAdConfig())
        || (configId == 'remoteSettings' && isAdmin() && isValidRemoteSettings())
      );
      allow delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidAdminNotification();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidAuditLog();
      allow update, delete: if false;
    }

    match /website_customizations/{customizationId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidWebsiteCustomization();
      allow update: if (isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidWebsiteCustomization()
        && request.resource.data.createdAt == resource.data.createdAt)
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /website_versions/{versionId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidWebsiteVersionSnapshot();
      allow update, delete: if false;
    }
  }
}
